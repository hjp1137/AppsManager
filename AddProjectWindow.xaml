<Window x:Class="AppsManager.AddProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目配置" Height="500" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0"
        ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="配置项目信息" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15"/>

        <!-- 基本配置 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <TextBlock Text="项目路径" VerticalAlignment="Center"/>
            <Grid Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtPath" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3D3D3D" Padding="5,2" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="浏览..." Click="BtnBrowse_Click" Margin="5,0,0,0" Background="#3D3D3D" Foreground="#FFFFFF" BorderThickness="0"/>
            </Grid>

            <TextBlock Text="项目名称" Grid.Row="1" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="1" Margin="0,4,10,4" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3D3D3D" Padding="5,2" VerticalContentAlignment="Center"/>

            <TextBlock Text="项目分组" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtGroup" Grid.Row="1" Grid.Column="3" Margin="0,4" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3D3D3D" Padding="5,2" VerticalContentAlignment="Center" Text="默认"/>
        </Grid>

        <!-- 启动项操作与快捷命令粘贴面板 -->
        <Grid Grid.Row="2" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="粘贴快捷命令:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TxtCmdPaste" Grid.Column="1" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#3D3D3D" Padding="5,2" VerticalContentAlignment="Center" Margin="0,0,5,0" ToolTip="例如：cd web &amp;&amp; pnpm dev:ip"/>
            <Button Grid.Column="2" Content="解析并添加" Click="BtnParseAdd_Click" Background="#1976D2" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,15,0"/>
            
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="➕ 新增启动项" Click="BtnAddSub_Click" Padding="10,4" Background="#2E7D32" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="➖ 删除启动项" Click="BtnDeleteSub_Click" Padding="10,4" Background="#C62828" Foreground="#FFFFFF" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <!-- 表格编辑器 (美化版) -->
        <DataGrid Grid.Row="3" x:Name="DgSubServices" AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="#1A1A1A" RowBackground="#2D2D2D" AlternatingRowBackground="#252525"
                  Foreground="#FFFFFF" BorderBrush="#3D3D3D" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3D3D3D"
                  RowHeaderWidth="0" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1A1A1A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#3D3D3D"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Padding" Value="0,4"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1B5E20"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#333333"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,5"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="服务名称" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="启动命令" Binding="{Binding StartCommand}" Width="200"/>
                <DataGridTextColumn Header="调试端口" Binding="{Binding Port}" Width="70"/>
                <DataGridTextColumn Header="运行工作目录" Binding="{Binding Path}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部确定/取消 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="确定" Width="80" Height="30" Click="BtnOk_Click" Background="#4CAF50" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="取消" Width="80" Height="30" Click="BtnCancel_Click" Background="#F44336" Foreground="#FFFFFF" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
